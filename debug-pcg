#!/usr/bin/env bash
set -e

# Java equivalency tests:
run_world_equivalency_test () {
	echo "World equivalency test with random seed $1, 0x5555 ..."	
	# java -jar java/mdl.jar src/unittests/pcg-world-java-equivalency-test.asm -equ PCG_WORLD_SEED1="$1" -equ PCG_WORLD_SEED2="0x5555" -asm+:html debug-pcg.html

	# print_lines=true
	print_lines=false
	while IFS= read -r line; do
		if [[ $print_lines == true ]] ;
		then
			echo $line
		else
			if [[ $line == *"test__"* ]] ;
			then
				echo $line
			fi
		fi
	done < <( java -jar java/mdl.jar src/unittests/pcg-world-java-equivalency-test.asm -equ PCG_WORLD_SEED1="$1" -equ PCG_WORLD_SEED2="0x5555" -e:u test_start test_end -e:watch "mdl-watch:" )
}

# World PCG tests:
# Seeds where the PCG is expected to succeed:
