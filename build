#!/usr/bin/env bash
set -e

DEBUGARG=${2:-0}


# Compile the game:
java -jar java/mdl.jar src/main.asm -bin xspelunker2.rom -st xspelunker2.sym -equ DEBUG="$DEBUGARG" -equ DEBUG_PCG="0" -equ INCLUDE_HARDCODED_WORLD_DATA="0" -asm+:html xspelunker2.html -sft xspelunker2.tsv

# Safety checks:
read_from_symbol_file () {
	# Read the value of a label from the symbol file generated by MDL.
	value="$(grep "$1" "$2" | cut -d ' ' -f3- | cut -c3-)"
	valuedec="$(echo $((16#$value)))"
	echo $valuedec
}

# Calculate ROM/RAM space available:
TOTALUSED=0
for IDX in "_0" "_1" "_2" "_3" "_4" "_5" "_6" "_7" "_8" "_9" "_10" "_11" "_12" "_13" "_14" "_15" "_16" "_17" "_18" "_19" "_20" "_21"
do
	PAGESIZE=16384
	STARTDEC=$(read_from_symbol_file "start_of_page${IDX}:" xspelunker2.sym)
	ENDDEC=$(read_from_symbol_file "end_of_page${IDX}:" xspelunker2.sym)
	USED=$((ENDDEC-STARTDEC))
	FREE=$((PAGESIZE-USED))
	echo "page${IDX}: using ${USED} (free: ${FREE})"
	TOTALUSED=$((TOTALUSED+USED))
done


FREE=$((22*16*1024 - TOTALUSED))
echo "total used: ${TOTALUSED} (free: ${FREE})"

END_OF_RAM="$(grep end_of_ram xspelunker2.sym | cut -d ' ' -f3- | cut -c3-)"
END_OF_RAMDEC="$(echo $((16#$END_OF_RAM)))"
FREE_RAM=$(($((16#f300)) - END_OF_RAMDEC))
echo "free RAM: ${FREE_RAM}"


# optimization suggestions:
# java -jar java/mdl.jar src/main.asm -equ DEBUG="$DEBUGARG" -equ DEBUG_PCG="0" -equ INCLUDE_HARDCODED_WORLD_DATA="0" -po
